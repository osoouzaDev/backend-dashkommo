PORT=8000

DB_HOST=testhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change_me
DB_NAME=defaultdb
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Opcional (preferivel): off | required | verify-ca
# DB_SSL_MODE=off
# Opcional (recomendado no Render): certificado CA em formato PEM
# DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Opcional: caminho para CA customizado (ex.: certs/ca.pem)
# DB_SSL_CA_PATH=

JWT_SECRET=change_me_with_high_entropy
JWT_ISSUER=backend-dashkommo
JWT_AUDIENCE=frontend-dashkommo

PASSWORD_PEPPER=change_me_with_high_entropy
WEBHOOK_SECRET=change_me_with_high_entropy
WEBHOOK_SIGNATURE_TOLERANCE_SEC=300
WEBHOOK_ALLOW_LEGACY_SECRET=false
REFRESH_TOKEN_TTL_DAYS=30

# Cookies HttpOnly para auth (recomendado em producao)
AUTH_COOKIES_ENABLED=false
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
ACCESS_TOKEN_COOKIE_MAX_AGE_SEC=1800
REFRESH_TOKEN_COOKIE_MAX_AGE_SEC=2592000
# AUTH_COOKIE_DOMAIN=.seudominio.com
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# Opcional: domínios adicionais permitidos no CORS, separados por vírgula
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
